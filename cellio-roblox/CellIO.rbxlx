local feed = label({ RichText = true, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, Size = UDim2.fromOffset(260, 100), Position = UDim2.new(1, -272, 0, 270), Parent = hud })
