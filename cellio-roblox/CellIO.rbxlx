label({ Text = "LEADERBOARD", TextColor3 = ACCENT, Font = Enum.Font.GothamBlack, TextSize = 13, Size = UDim2.new(1, -20, 0, 18), Position = UDim2.fromOffset(10, 8), Parent = lbPanel })
